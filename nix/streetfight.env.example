# Example of the environment file the streetfight service requires at
# ${stateDir}/secrets/streetfight.env (default /data/secrets/streetfight.env).
# The unit refuses to start without it, and refuses the placeholder values
# below - see the preflight check in nix/streetfight.nix.
#
# NEVER commit the real file. For the cloud host, deliver it at install time
# with `nixos-anywhere --extra-files` (directory mode 0700), so it exists
# before first boot; after that it lives on the host and survives
# `nixos-rebuild`.

# Required. Signs join links and item QR payloads - rotating it invalidates
# every code already shared. Generate once: openssl rand -hex 32
SECRET_KEY=not-so-secret

# Required.
ADMIN_PASSWORD=password

# Required. The public origin; what join links and item QRs encode. Must
# agree with services.streetfight.hostname when that is set.
WEBSITE_URL=https://streetfight.example.com

# Optional - CharlesBot. Leave unset and shot review is simply off.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=google/gemini-3.7-flash-20260813

# Optional. Unset, escalation mirrors OPENROUTER_MODEL above, so it is on by
# default wherever recognition is - the same model asked a second,
# differently-shaped question. Free to name a genuinely stronger model
# instead (shown here), but doesn't have to.
# OPENROUTER_ESCALATION_MODEL=google/gemini-3.7-pro-20260813

# Optional - the landmarks that are not in the public repository
# (backend/venues.py). Anything named LANDMARK_<NAME>="<lat>,<long>" is merged
# into the active venue's landmarks at startup, so it appears in the admin's
# circle dropdown like any other place.
#
# CIRCLE0..CIRCLE3 are special only in that backend/circles.py's CIRCLE_PLAN
# names them: the game arms each in turn as the one before it closes, so the
# admin never has to remember to place the next circle and the early-warning
# card always has something to reveal. A missing one is not fatal - that
# circle just has to be placed by hand.
#
# Their radii (in km) are here too rather than in the code, for the same
# reason the coordinates are: how big the last circle is gives away as much
# about the night as where it is. A circle is armed automatically only when
# the environment has supplied both halves.
# LANDMARK_CIRCLE0=51.4958,-0.1309
# LANDMARK_CIRCLE1=51.4958,-0.1309
# LANDMARK_CIRCLE2=51.4958,-0.1309
# LANDMARK_CIRCLE3=51.4958,-0.1309
# CIRCLE_RADIUS_CIRCLE0=0.70
# CIRCLE_RADIUS_CIRCLE1=0.42
# CIRCLE_RADIUS_CIRCLE2=0.18
# CIRCLE_RADIUS_CIRCLE3=0.05
#
# Drop locations travel exactly the same way, and need no code at all:
# LANDMARK_DROP_BRIDGE=51.4958,-0.1309
