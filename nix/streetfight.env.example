# Example of the environment file the streetfight service requires at
# ${stateDir}/secrets/streetfight.env (default /data/secrets/streetfight.env).
# The unit refuses to start without it, and refuses the placeholder values
# below - see the preflight check in nix/streetfight.nix.
#
# NEVER commit the real file. For the cloud host, deliver it at install time
# with `nixos-anywhere --extra-files` (directory mode 0700), so it exists
# before first boot; after that it lives on the host and survives
# `nixos-rebuild`.

# Required. Signs join links and item QR payloads - rotating it invalidates
# every code already shared. Generate once: openssl rand -hex 32
SECRET_KEY=not-so-secret

# Required.
ADMIN_PASSWORD=password

# Required. The public origin; what join links and item QRs encode. Must
# agree with services.streetfight.hostname when that is set.
WEBSITE_URL=https://streetfight.example.com

# Optional - CharlesBot. Leave unset and shot review is simply off.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=google/gemini-3.7-flash-20260813

# Optional. Leave unset and escalation is off. Free to name a stronger model
# (shown here), but doesn't have to - the escalation pass gets more context
# than the cheap one (ranked candidates + reference photos), so re-running the
# same model as OPENROUTER_MODEL is also a reasonable choice.
# OPENROUTER_ESCALATION_MODEL=google/gemini-3.7-pro-20260813
