# SITE_ADDRESS is the public hostname. Left unset it stays "localhost"
# (dev / LAN behaviour, self-signed cert); set to a real domain and Caddy
# obtains a Let's Encrypt certificate for it automatically. Phones require a
# trusted HTTPS origin for the camera and geolocation APIs, so a real domain
# is mandatory for any deployment players will actually use.
http://, https://{$SITE_ADDRESS:localhost} {
	handle /api/* {
		reverse_proxy {$API_URL:http://localhost:8000}
	}

	handle /docs* {
		reverse_proxy {$API_URL:http://localhost:8000}
	}

	handle /openapi.json {
		reverse_proxy {$API_URL:http://localhost:8000}
	}

	# CRA's build output hashes filenames under /static, so it's always safe to
	# cache them forever - a content change gets a new filename.
	handle /static/* {
		root * result
		header Cache-Control "public, max-age=31536000, immutable"
		encode gzip zstd
		file_server
	}

	handle {
		root * result

		# Templates give static sites some dynamic features
		# templates

		# Compress responses according to Accept-Encoding headers
		encode gzip zstd

		# Make HTML file extension optional
		try_files {path} /index.html
		file_server
	}
}
